    if (statusMap['Order Delivered']!) return 'Order Delivered';
    if (statusMap['Out for Delivery']!) return 'Out for Delivery';
    if (statusMap['Preparing']!) return 'Preparing';
    return 'Order Received';
  }

  void _saveStatus() async {
    String newStatus = _getNewStatus();
    if (newStatus != currentStatus) {
      await FirebaseService().updateOrderStatus(widget.order.id, newStatus);
      // Show confirmation/toast
