A. Data Model (lib/models/order_model.dart)
This class defines the structure of data stored in Firestore.

Dart

import 'package:cloud_firestore/cloud_firestore.dart';

class OrderModel {
  final String id;
  final String userId;
  final String customerAddress;
  final String customerNumber;
  final String itemsOrdered; // Simplification: e.g., "Chocolate Brownie Cake"
  final String status;
  final Timestamp timestamp;

  OrderModel({
    required this.id,
    required this.userId,
    required this.customerAddress,
    required this.customerNumber,
    required this.itemsOrdered,
    required this.status,
    required this.timestamp,
  });

  // Factory method to create an OrderModel from a Firestore document
  factory OrderModel.fromFirestore(DocumentSnapshot doc) {
    Map data = doc.data() as Map<String, dynamic>;
    return OrderModel(
      id: doc.id,
      userId: data['userId'] ?? '',
      customerAddress: data['customerAddress'] ?? '',
      customerNumber: data['customerNumber'] ?? '',
      itemsOrdered: data['itemsOrdered'] ?? '',
      status: data['status'] ?? 'Order Received',
      timestamp: data['timestamp'] ?? Timestamp.now(),
    );
  }

  // Method to convert the model to a map for Firestore
  Map<String, dynamic> toMap() {
    return {
      'userId': userId,
      'customerAddress': customerAddress,
      'customerNumber': customerNumber,
      'itemsOrdered': itemsOrdered,
      'status': status,
      'timestamp': timestamp,
    };
  }
}
B. Firebase Service Layer (lib/services/firebase_service.dart)
This handles all database operations (CRUD).

Dart

import 'package:cloud_firestore/cloud_firestore.dart';
import '../models/order_model.dart';

class FirebaseService {
  final FirebaseFirestore _db = FirebaseFirestore.instance;

  // 1. PLACE ORDER (User App)
  Future<void> placeNewOrder({
    required String userId,
    required String address,
    required String number,
    required String items,
  }) async {
    await _db.collection('orders').add(OrderModel(
      id: '', // ID will be set by Firestore
      userId: userId,
      customerAddress: address,
      customerNumber: number,
      itemsOrdered: items,
      status: 'Order Received', // Initial status
      timestamp: Timestamp.now(),
    ).toMap());
  }

  // 2. GET USER ORDERS (User App)
  Stream<List<OrderModel>> getOrdersForUser(String userId) {
    return _db
        .collection('orders')
        .where('userId', isEqualTo: userId)
        .orderBy('timestamp', descending: true)
        .snapshots()
        .map((snapshot) => snapshot.docs
            .map((doc) => OrderModel.fromFirestore(doc))
            .toList());
  }

  // 3. GET ALL ORDERS (Admin Panel)
  Stream<List<OrderModel>> getAllOrders() {
    return _db
        .collection('orders')
        .orderBy('timestamp', descending: true)
        .snapshots()
        .map((snapshot) => snapshot.docs
            .map((doc) => OrderModel.fromFirestore(doc))
            .toList());
  }

  // 4. UPDATE ORDER STATUS (Admin Panel)
  Future<void> updateOrderStatus(String orderId, String newStatus) async {
    await _db.collection('orders').doc(orderId).update({
      'status': newStatus,
    });
    // NOTE: This is where you would trigger an FCM push notification
    // to the user associated with this orderId.
  }
}
