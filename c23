Question 09: Build a Flutter application with two screens, "About" and "Home". Use a dedicated routing class and allow the background color of the Scaffold and AppBar in the About screen to be set from the Home screen.

source code :
import 'package:flutter/material.dart';

void main() {
  runApp(const MyApp());
}

// Routing Class
class AppRoutes {
  static const String home = '/';
  static const String about = '/about';

  static Route<dynamic> generateRoute(RouteSettings settings) {
    switch (settings.name) {
      case home:
        return MaterialPageRoute(builder: (_) => const HomeScreen());
      case about:
        final args = settings.arguments as Map<String, dynamic>;
        return MaterialPageRoute(
            builder: (_) => AboutScreen(
                  scaffoldColor: args['scaffoldColor'],
                  appBarColor: args['appBarColor'],
                ));
      default:
        return MaterialPageRoute(
            builder: (_) => const Scaffold(
                  body: Center(child: Text('No route defined')),
                ));
    }
  }
}

// Main App
class MyApp extends StatelessWidget {
  const MyApp({super.key});

  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      debugShowCheckedModeBanner: false,
      title: 'Routing Example',
      onGenerateRoute: AppRoutes.generateRoute,
      initialRoute: AppRoutes.home,
    );
  }
}

// Home Screen
class HomeScreen extends StatefulWidget {
  const HomeScreen({super.key});

  @override
  State<HomeScreen> createState() => _HomeScreenState();
}

class _HomeScreenState extends State<HomeScreen> {
  Color _selectedScaffoldColor = Colors.white;
  Color _selectedAppBarColor = Colors.blue;

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      appBar: AppBar(
        title: const Text("Home Screen"),
        centerTitle: true,
        backgroundColor: Colors.deepPurple,
      ),
      body: Padding(
        padding: const EdgeInsets.all(20),
        child: Column(
          children: [
            const Text(
              "Select Scaffold Color for About Screen:",
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 10),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                _colorButton(Colors.white),
                _colorButton(Colors.yellow),
                _colorButton(Colors.greenAccent),
                _colorButton(Colors.orangeAccent),
              ],
            ),
            const SizedBox(height: 20),
            const Text(
              "Select AppBar Color for About Screen:",
              style: TextStyle(fontSize: 18, fontWeight: FontWeight.bold),
            ),
            const SizedBox(height: 10),
            Row(
              mainAxisAlignment: MainAxisAlignment.spaceAround,
              children: [
                _appBarColorButton(Colors.blue),
                _appBarColorButton(Colors.red),
                _appBarColorButton(Colors.purple),
                _appBarColorButton(Colors.teal),
              ],
            ),
            const SizedBox(height: 40),
            ElevatedButton(
              onPressed: () {
                Navigator.pushNamed(
                  context,
                  AppRoutes.about,
                  arguments: {
                    'scaffoldColor': _selectedScaffoldColor,
                    'appBarColor': _selectedAppBarColor,
                  },
                );
              },
              style: ElevatedButton.styleFrom(
                  backgroundColor: Colors.deepPurple,
                  padding: const EdgeInsets.symmetric(
                      horizontal: 25, vertical: 15)),
              child: const Text(
                "Go to About Screen",
                style: TextStyle(fontSize: 18, color: Colors.white),
              ),
            ),
          ],
        ),
      ),
    );
  }

  Widget _colorButton(Color color) {
    return GestureDetector(
      onTap: () {
        setState(() {
          _selectedScaffoldColor = color;
        });
      },
      child: CircleAvatar(
        radius: 20,
        backgroundColor: color,
        child: _selectedScaffoldColor == color
            ? const Icon(Icons.check, color: Colors.black)
            : null,
      ),
    );
  }

  Widget _appBarColorButton(Color color) {
    return GestureDetector(
      onTap: () {
        setState(() {
          _selectedAppBarColor = color;
        });
      },
      child: CircleAvatar(
        radius: 20,
        backgroundColor: color,
        child: _selectedAppBarColor == color
            ? const Icon(Icons.check, color: Colors.white)
            : null,
      ),
    );
  }
}

// About Screen
class AboutScreen extends StatelessWidget {
  final Color scaffoldColor;
  final Color appBarColor;

  const AboutScreen(
      {super.key, required this.scaffoldColor, required this.appBarColor});

  @override
  Widget build(BuildContext context) {
    return Scaffold(
      backgroundColor: scaffoldColor,
      appBar: AppBar(
        title: const Text("About Screen"),
        backgroundColor: appBarColor,
        centerTitle: true,
      ),
      body: const Center(
        child: Text(
          "This is the About Screen",
          style: TextStyle(fontSize: 24, fontWeight: FontWeight.bold),
        ),
      ),
    );
  }
}
