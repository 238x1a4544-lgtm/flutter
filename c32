Question 8: Create a simple Provider that provides a counter value and a button to increment the counter. Display the counter value in another widget.

source code :
// main.dart
import 'package:flutter/material.dart';
import 'package:provider/provider.dart';

// Step 1: Create a Counter Provider
class CounterProvider with ChangeNotifier {
  int _counter = 0;

  int get counter => _counter;

  void increment() {
    _counter++;
    notifyListeners(); // Notify listeners when counter changes
  }
}

void main() {
  runApp(
    ChangeNotifierProvider(
      create: (_) => CounterProvider(),
      child: MyApp(),
    ),
  );
}

class MyApp extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    return MaterialApp(
      title: 'Provider Counter Example',
      home: CounterScreen(),
    );
  }
}

// Step 2: CounterScreen with Increment Button
class CounterScreen extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    final counterProvider = Provider.of<CounterProvider>(context);

    return Scaffold(
      appBar: AppBar(title: Text('Provider Counter')),
      body: Center(
        child: Column(
          mainAxisAlignment: MainAxisAlignment.center,
          children: [
            Text(
              'Counter Value:',
              style: TextStyle(fontSize: 20),
            ),
            SizedBox(height: 10),
            // Step 3: Display Counter in another Widget
            CounterDisplay(),
            SizedBox(height: 20),
            ElevatedButton(
              onPressed: () {
                counterProvider.increment();
              },
              child: Text('Increment Counter'),
            ),
          ],
        ),
      ),
    );
  }
}

// Step 3: Widget to Display Counter Value
class CounterDisplay extends StatelessWidget {
  @override
  Widget build(BuildContext context) {
    // Use Consumer to rebuild only this widget when counter changes
    return Consumer<CounterProvider>(
      builder: (context, counterProvider, child) {
        return Text(
          '${counterProvider.counter}',
          style: TextStyle(fontSize: 40, fontWeight: FontWeight.bold),
        );
      },
    );
  }
