Question 22: Render given texts based on the cross-platform. The first text should be shown on flutter web and the second one should be shown on android devices. What will your approach be to solve this problem statement?

Text 1: This is for the web!!
Text 2: This is for android!!

Hint 1:- Use Text view.
Hint 2:- Add check based on a platform like that if the platform is web than web text, else android text
source code :
import 'package:flutter/foundation.dart'; // For kIsWeb
import 'dart:io' show Platform;           // For Platform.isAndroid
import 'package:flutter/material.dart';

void main() {
  runApp(const PlatformApp());
}

class PlatformApp extends StatelessWidget {
  const PlatformApp({super.key});

  @override
  Widget build(BuildContext context) {
    return const MaterialApp(
      debugShowCheckedModeBanner: false,
      home: PlatformTextScreen(),
    );
  }
}

class PlatformTextScreen extends StatelessWidget {
  const PlatformTextScreen({super.key});

  @override
  Widget build(BuildContext context) {
    String displayText;

    // Check platform
    if (kIsWeb) {
      displayText = "This is for the web!!";
    } else if (Platform.isAndroid) {
      displayText = "This is for android!!";
    } else {
      displayText = "This platform is not supported in this demo.";
    }

    return Scaffold(
      appBar: AppBar(
        title: const Text("Platform Specific Text"),
        centerTitle: true,
      ),
      body: Center(
        child: Text(
          displayText,
          style: const TextStyle(
            fontSize: 24,
            fontWeight: FontWeight.bold,
            color: Colors.blueAccent,
          ),
          textAlign: TextAlign.center,
        ),
      ),
    );
  }
}
